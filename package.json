{
  "name": "underdogs-innercircle-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/vitest/vitest.mjs",
    "db:generate": "drizzle-kit generate && tsx scripts/bundle-migrations.ts",
    "db:reset": "node -e \"require('fs').rmSync('.data/pglite',{recursive:true,force:true})\"",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "drizzle-orm": "0.45.3",
    "gsap": "3.15.0",
    "jose": "6.2.12",
    "maath": "0.10.8",
    "next": "16.3.6",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
