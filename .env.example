# Every variable is optional in demo mode: `npm install && npm run dev` needs none of them.
# Never give a secret a NEXT_PUBLIC_ prefix.

# Demo controls and the on-screen OTP toast.
# Default: on in development, off in production. Set to true for a Vercel demo.
DEMO_MODE=

# Public base URL for share images, JSON-LD and coin links. Vercel's URL is used when unset.
APP_URL=

# Postgres (Neon or the Supabase pooler). Unset: embedded PGlite in .data/pglite.
# Required for a shared, persistent demo on Vercel.
DATABASE_URL=

# Generated and stored in the database when unset (demo mode only).
SESSION_SECRET=
CRON_SECRET=

# Goldie. Unset: the offline intent router.
GOOGLE_GENERATIVE_AI_API_KEY=
GOLDIE_MODEL=gemini-flash-latest

# Rate limits. Unset: in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
